# Production backend identity: exact deployed gameApi URL (OIDC audience).
REWARDS_RUNTIME_SERVICE_ACCOUNT=rewards-runtime@between-turns-paul.iam.gserviceaccount.com
GAME_API_AUDIENCE=https://REGION-PROJECT.cloudfunctions.net/rewardsGameApi
# Register each trusted game's service account and exact callback URL(s).
GAME_CLIENTS_JSON={"example-game":{"serviceAccount":"game-runtime@GAME_PROJECT.iam.gserviceaccount.com","redirectUris":["https://GAME_HOST/callback"]}}
REWARDS_BROWSER_ORIGINS=https://between-turns-rpg-rewards.web.app
BETWEEN_TURNS_API_URL=https://us-central1-between-turns-paul.cloudfunctions.net/integrationApi
CUTOVER_WRITES_ENABLED=false
