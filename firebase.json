{
  "functions": [
    {
      "source": "apps/hub/functions",
      "codebase": "hub",
      "predeploy": [
        "npm --prefix apps/hub/functions run build"
      ]
    },
    {
      "source": "apps/rpg-rewards/functions",
      "codebase": "rewards",
      "predeploy": [
        "npm --prefix apps/rpg-rewards/functions run build"
      ]
    },
    {
      "source": "games/rpg-bingo/functions",
      "codebase": "rpg-bingo",
      "predeploy": [
        "npm --prefix games/rpg-bingo/functions run build"
      ]
    },
    {
      "source": "games/roll-race/functions",
      "codebase": "roll-race",
      "predeploy": [
        "npm --prefix games/roll-race/functions run build"
      ]
    },
    {
      "source": "games/push-your-luck/functions",
      "codebase": "push-your-luck",
      "predeploy": [
        "npm --prefix games/push-your-luck/functions run build"
      ]
    },
    {
      "source": "games/horse-race/functions",
      "codebase": "horse-race",
      "predeploy": [
        "npm --prefix games/horse-race/functions run build"
      ]
    }
  ],
  "firestore": [
    {
      "database": "(default)",
      "rules": "apps/hub/firestore.rules",
      "indexes": "apps/hub/firestore.indexes.json"
    },
    {
      "database": "rpg-rewards",
      "rules": "apps/rpg-rewards/firestore.rules",
      "indexes": "apps/rpg-rewards/firestore.indexes.json"
    },
    {
      "database": "rpg-bingo",
      "rules": "games/rpg-bingo/firestore.rules",
      "indexes": "games/rpg-bingo/firestore.indexes.json"
    },
    {
      "database": "roll-race",
      "rules": "games/roll-race/firestore.rules",
      "indexes": "games/roll-race/firestore.indexes.json"
    },
    {
      "database": "push-your-luck",
      "rules": "games/push-your-luck/firestore.rules",
      "indexes": "games/push-your-luck/firestore.indexes.json"
    },
    {
      "database": "horse-race",
      "rules": "games/horse-race/firestore.rules",
      "indexes": "games/horse-race/firestore.indexes.json"
    }
  ],
  "hosting": [
    {
      "public": "apps/hub/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.google.com https://www.gstatic.com https://recaptcha.google.com; style-src 'self'; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://*.googleapis.com https://*.cloudfunctions.net https://*.run.app https://*.firebaseapp.com; frame-src 'self' https://between-turns-paul.firebaseapp.com https://www.google.com https://recaptcha.google.com https://between-turns-rpg-rewards.web.app https://between-turns-rpg-bingo.web.app https://between-turns-roll-race.web.app https://between-turns-push-your-luck.web.app https://between-turns-horse-race.web.app; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
            }
          ]
        }
      ],
      "target": "hub"
    },
    {
      "public": "apps/rpg-rewards/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/embeddedApi",
          "function": {
            "functionId": "rewardsEmbeddedApi",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors https://between-turns-paul.web.app"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "target": "rpg-rewards"
    },
    {
      "public": "games/rpg-bingo/dist",
      "rewrites": [
        {
          "source": "/embeddedApi",
          "function": {
            "functionId": "bingoEmbeddedApi",
            "region": "us-central1"
          }
        },
        {
          "source": "/embed",
          "destination": "/index.html"
        },
        {
          "source": "/embed/",
          "destination": "/index.html"
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/embed{,/**}",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors https://between-turns-paul.web.app"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ],
      "target": "rpg-bingo"
    },
    {
      "public": "games/roll-race/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/embeddedApi",
          "function": {
            "functionId": "rollRaceApi",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors https://between-turns-paul.web.app; base-uri 'none'; object-src 'none'"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            }
          ]
        }
      ],
      "target": "roll-race"
    },
    {
      "public": "games/push-your-luck/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/embeddedApi",
          "function": {
            "functionId": "pushYourLuckApi",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors https://between-turns-paul.web.app; base-uri 'none'; object-src 'none'"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            }
          ]
        }
      ],
      "target": "push-your-luck"
    },
    {
      "public": "games/horse-race/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/embeddedApi",
          "function": {
            "functionId": "horseRaceApi",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors https://between-turns-paul.web.app; base-uri 'none'; object-src 'none'"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Cache-Control",
              "value": "no-store"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            }
          ]
        }
      ],
      "target": "horse-race"
    }
  ],
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9299
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8280
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5201
    },
    "ui": {
      "host": "127.0.0.1",
      "port": 4200
    },
    "eventarc": {
      "host": "127.0.0.1",
      "port": 9399
    },
    "singleProjectMode": true,
    "hosting": {
      "host": "127.0.0.1",
      "port": 5000
    }
  }
}
