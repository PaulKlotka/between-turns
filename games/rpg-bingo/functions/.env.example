# Server-side integrations. Configure IAM and app registration before enabling.
BETWEEN_TURNS_API_URL=https://us-central1-between-turns-paul.cloudfunctions.net/integrationApi
REWARDS_GAME_API_URL=https://us-central1-between-turns-paul.cloudfunctions.net/rewardsGameApi
BINGO_BROWSER_ORIGINS=https://between-turns-rpg-bingo.web.app
# Local emulator: use the actual loopback API URLs and add the Vite origin above.
# The Rewards service must implement docs/INTEGRATION.md, not its legacy API.
BINGO_RUNTIME_SERVICE_ACCOUNT=bingo-runtime@between-turns-paul.iam.gserviceaccount.com
CUTOVER_WRITES_ENABLED=false
